{
  "name": "payflow-dashboard",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  },
  "description": "A modern, secure, and scalable payment acceptance dashboard for PayFlow, providing real-time transaction monitoring, merchant management, payment processing, analytics, reporting, and developer integrations.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domwokorach/PayFlow-Acceptance-Solution.git"
  },
  "keywords": [
    "payflow",
    "payflow-dashboard",
    "fintech",
    "payments",
    "payment-processing",
    "payment-gateway",
    "merchant-management",
    "transactions",
    "analytics",
    "reporting",
    "dashboard",
    "react",
    "nextjs",
    "typescript",
    "api",
    "secure-payments"
  ],
