# Copy of the variables ./bootstrap.sh writes to .env (which is git-ignored). Never commit real values.
JENKINS_ADMIN_PASSWORD=generated-by-bootstrap
JENKINS_AGENT_PASSWORD=generated-by-bootstrap
# Repository Jenkins builds. HTTPS URL of your GitHub repo, or /srv/payflow.git for the local-repo override.
PAYFLOW_GIT_URL=https://github.com/OWNER/payflow-platform.git
PAYFLOW_GIT_BRANCH=*/main
# Optional: id of a Jenkins "username with password" credential (GitHub PAT) for a private repository.
PAYFLOW_GIT_CREDENTIALS_ID=
