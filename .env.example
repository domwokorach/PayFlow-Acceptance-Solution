# Copy to .env and fill in YOUR Visa Acceptance sandbox (test) credentials. Never commit .env.
PAYFLOW_VISA_ENABLED=false
PAYFLOW_VISA_MERCHANT_ID=your_sandbox_merchant_id
PAYFLOW_VISA_KEY_ID=your_sandbox_key_id
PAYFLOW_VISA_SHARED_SECRET=your_sandbox_shared_secret_base64
# Optional: synthetic history for UI development only (never for the live dashboard)
PAYFLOW_SEED_DEMO_DATA=false
# Optional extra merchants: merchantId=key,merchantId=key (keys >= 16 chars)
PAYFLOW_BOOTSTRAP_KEYS=
PAYFLOW_OTLP_ENABLED=false
