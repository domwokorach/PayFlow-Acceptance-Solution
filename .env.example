# Dashboard (Next.js) server settings. Copy to frontend/.env.local for `npm run dev`; in production set these in
# Vercel (Project > Settings > Environment Variables). None of them may be prefixed NEXT_PUBLIC_.

# --- Local development: all optional ---
# Defaults to http://localhost:8080 and the local demo key, with no login. Used only when NOT on Vercel and
# PAYFLOW_PUBLIC_DEPLOYMENT is not "true".
# PAYFLOW_API_ORIGIN=http://localhost:8080
# PAYFLOW_DEMO_API_KEY=local-only-change-me

# --- Production (Vercel): ALL REQUIRED. The build still succeeds without them, but every page and API call
#     answers 503 "Service is not configured" until they are valid (no localhost or default-key fallback). ---
# HTTPS origin of the deployed PayFlow API (no path, no trailing slash, not localhost / private addresses)
PAYFLOW_API_ORIGIN=
# Must equal the backend's PAYFLOW_DEMO_API_KEY. 32+ random characters, not the local key.
#   openssl rand -base64 36
PAYFLOW_DEMO_API_KEY=
# Dashboard sign-in. Password: 14+ characters. Secret: 32+ random characters, different from the password.
PAYFLOW_DASHBOARD_USER=operator
PAYFLOW_DASHBOARD_PASSWORD=
PAYFLOW_SESSION_SECRET=

# --- Optional ---
# Upstream request timeout in ms (1000-25000, default 10000)
# PAYFLOW_API_TIMEOUT_MS=10000
# Force public-deployment rules outside Vercel (other hosts, or a production-like local run)
# PAYFLOW_PUBLIC_DEPLOYMENT=true
