# Local development (docker compose reads this file). Copy to .env and fill in YOUR Visa Acceptance sandbox (test)
# credentials. Never commit .env. Production values live only in Render (backend) and Vercel (dashboard):
# see docs/deployment.md and frontend/.env.example.

# --- Backend (Spring Boot API) ---
# Visa credentials exist ONLY on the backend. They must never be set in Vercel or any NEXT_PUBLIC_* variable.
PAYFLOW_VISA_ENABLED=false
PAYFLOW_VISA_MERCHANT_ID=your_sandbox_merchant_id
PAYFLOW_VISA_KEY_ID=your_sandbox_key_id
PAYFLOW_VISA_SHARED_SECRET=your_sandbox_shared_secret_base64
# Synthetic history for UI development only (never for a live or public deployment)
PAYFLOW_SEED_DEMO_DATA=false
# Optional extra merchants: merchantId=key,merchantId=key (keys >= 16 chars locally, >= 32 in production)
PAYFLOW_BOOTSTRAP_KEYS=
PAYFLOW_OTLP_ENABLED=false

# --- Production-only backend settings (set in Render, not here) ---
# PAYFLOW_DEMO_API_KEY=<32+ random characters>   (local compose uses a fixed local key)
# PAYFLOW_REQUIRE_STRONG_KEYS=true               (refuses the local key and short keys)
# PAYFLOW_ACTUATOR_EXPOSURE=health               (no public metrics)
# DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD, or DB_URL=jdbc:postgresql://...
